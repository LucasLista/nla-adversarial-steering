#!/bin/bash -l
#BSUB -q gpuv100
#BSUB -J nla-stepper
#BSUB -n 4
#BSUB -gpu "num=1:mode=shared:j_exclusive=yes"
#BSUB -R "span[hosts=1] rusage[mem=6GB]"
#BSUB -M 7GB
#BSUB -W 4:00
#BSUB -o runs/hpc-%J.out
#BSUB -e runs/hpc-%J.err
set -euo pipefail
cd "${LS_SUBCWD:?Submit from the project directory}"
source hpc/common.sh
exec uv run --locked python -m nla.launch --port "$server_port" --backend-port "$backend_port" --gpu-layers 99 --threads 4 --listen-host 0.0.0.0 --auth-token-file "runs/token-${LSB_JOBID}.txt" --audit-log
