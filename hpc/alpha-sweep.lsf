#!/bin/bash -l
#BSUB -q gpuv100
#BSUB -J nla-alpha
#BSUB -n 4
#BSUB -gpu "num=1:mode=shared:j_exclusive=yes"
#BSUB -R "select[hname!='n-62-20-6' && gpu32gb] span[hosts=1] rusage[mem=6GB]"
#BSUB -M 7GB
#BSUB -W 24:00
#BSUB -o runs/hpc-%J.out
#BSUB -e runs/hpc-%J.err
set -euo pipefail
cd "${LS_SUBCWD:?Submit from the project directory}"
source hpc/common.sh
# Steering multipliers for h + m*delta; m=1 is the parameter-free method, m=0 the unsteered baseline.
batch_args=(--output runs/alpha-sweep
            --multipliers 0 0.25 0.5 0.75 1 1.5 2 3 4 6
            --editor "${NLA_EDITOR:-openai}"
            --shard "${NLA_SHARD:?Set NLA_SHARD=i/n when submitting}")
if [ -n "${NLA_EDITOR_MODEL:-}" ]; then
    batch_args+=(--editor-model "$NLA_EDITOR_MODEL")
fi
source hpc/run_batch.sh
