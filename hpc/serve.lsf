#!/bin/bash -l
# Serve the stepper API on a V100; connect from a laptop through an SSH tunnel.
#BSUB -q gpuv100
#BSUB -J nla-serve
#BSUB -n 4
#BSUB -gpu "num=1:mode=shared:j_exclusive=yes"
#BSUB -R "select[gpu32gb] span[hosts=1] rusage[mem=6GB]"
