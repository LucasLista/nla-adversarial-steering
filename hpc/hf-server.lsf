#!/bin/bash -l
#BSUB -q gpuv100
#BSUB -J nla-gemma-hf
#BSUB -n 8
#BSUB -gpu "num=2:mode=exclusive_process"
#BSUB -R "span[hosts=1] rusage[mem=8GB]"
#BSUB -M 9GB
#BSUB -W 4:00
#BSUB -o runs/hf-%J.out
#BSUB -e runs/hf-%J.err
set -euo pipefail
cd "${LS_SUBCWD:?Submit from project directory}"
export PATH="$HOME/.local/bin:$PATH"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=4
unset HF_TOKEN HUGGING_FACE_HUB_TOKEN OPENAI_API_KEY
mkdir -p runs
model="${NLA_HF_MODEL:-gemma3-12b}"
if [[ ! -x .runtime/hf-env/bin/python ]]; then
    uv venv --python 3.12 .runtime/hf-env
fi
uv pip install --python .runtime/hf-env/bin/python torch==2.6.0 --index-url https://download.pytorch.org/whl/cu124
uv pip install --python .runtime/hf-env/bin/python -r hpc/hf-requirements.txt
server_port=$((50000 + LSB_JOBID % 10000))
printf '%s\n' "$server_port" > "runs/port-${LSB_JOBID}.txt"
hostname -f > "runs/host-${LSB_JOBID}.txt"
umask 077
.runtime/hf-env/bin/python -c 'import secrets; print(secrets.token_hex(32))' > "runs/token-${LSB_JOBID}.txt"
exec .runtime/hf-env/bin/python hf_server.py --model "$model" --listen-host 0.0.0.0 --port "$server_port" --auth-token-file "runs/token-${LSB_JOBID}.txt" --job "$LSB_JOBID"
